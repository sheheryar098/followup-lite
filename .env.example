# SQLite database (relative to the prisma/ directory)
DATABASE_URL="file:./dev.db"

# Optional password gate. Leave unset for an open local demo.
# AUTH_PASSWORD="change-me"
# AUTH_SECRET="a-long-random-string"

# Optional email digest via Resend. If either value is missing, FollowUp Lite
# falls back to in-app + browser notifications.
# RESEND_API_KEY="re_xxxxxxxxx"
# DIGEST_TO="you@example.com"
# DIGEST_FROM="FollowUp Lite <onboarding@resend.dev>"

# Optional shared secret for GET/POST /api/digest (cron).
# CRON_SECRET="change-me"
